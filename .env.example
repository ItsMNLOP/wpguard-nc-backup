# Copy to .env and fill with generated values. docker/scripts/bootstrap.ps1
# does this for you automatically — this file documents the shape only.
# Never commit the real .env (it is gitignored).

COMPOSE_PROJECT_NAME=wpguard-test

# --- source WordPress DB ---
WP_SOURCE_DB_ROOT_PASSWORD=
WP_SOURCE_DB_NAME=wp_source
WP_SOURCE_DB_USER=wp_source
WP_SOURCE_DB_PASSWORD=
WP_SOURCE_TABLE_PREFIX=wps_

# --- restore-target WordPress DB ---
WP_RESTORE_DB_ROOT_PASSWORD=
WP_RESTORE_DB_NAME=wp_restore
WP_RESTORE_DB_USER=wp_restore
WP_RESTORE_DB_PASSWORD=
WP_RESTORE_TABLE_PREFIX=wpr_

# --- Nextcloud DB ---
NC_DB_ROOT_PASSWORD=
NC_DB_NAME=nextcloud
NC_DB_USER=nextcloud
NC_DB_PASSWORD=

# --- Nextcloud admin bootstrap (disposable test instance only) ---
NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=

# --- WordPress admin bootstrap (both instances, disposable test only) ---
WP_ADMIN_USER=wpadmin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=wpadmin@wpguard-test.local

# --- dedicated non-admin Nextcloud backup account (plugin uses this) ---
NC_BACKUP_USER=wpguard-backup
NC_BACKUP_USER_PASSWORD=
# app password is generated at bootstrap time via OCS API, not stored here
